# ==============================================================================
# ACHEI AQUI CACHOEIRAS DE MACACU - VARIÁVEIS DE AMBIENTE DE PRODUÇÃO (GO-LIVE)
# ==============================================================================

# Ambiente de Execução
NODE_ENV=production
PORT=3000
APP_ENV=production



# Gateway de Pagamentos Asaas (Split Automático 10% Plataforma / 90% Lojista)
# Obtenha sua chave oficial no painel do Asaas: Menu Integrações > Chaves de API
ASAAS_API_KEY=
# Wallet ID da subconta MEI do Administrador Master (recebe os 10% de taxa da plataforma)
ASAAS_WALLET_ID_MASTER=
# URL oficial de Produção: https://api.asaas.com/v3 (ou https://sandbox.asaas.com/api/v3 para homologação)
ASAAS_URL=https://api.asaas.com/v3
# Percentual de comissão padrão retido pela plataforma sobre as vendas
ASAAS_COMMISSION_PERCENT=10.0

# Chave PIX Oficial da Plataforma (CNPJ 30.810.800/0001-39)
VITE_PIX_KEY=financeiro@acheiaquicachoeiras.com.br
VITE_PIX_RECEIVER_NAME=ACHEI AQUI CACHOEIRAS
VITE_PIX_RECEIVER_CITY=CACHOEIRAS DE MACACU
VITE_PIX_CNPJ=30.810.800/0001-39
VITE_PIX_GATEWAY_PROVIDER=ASAAS

# Gateway de Notificações WhatsApp (Z-API / Evolution API)
VITE_WHATSAPP_API_ENDPOINT=https://api.z-api.io/instances/YOUR_INSTANCE/token/YOUR_TOKEN/send-text
VITE_WHATSAPP_API_TOKEN=

# Gateway de Verificação por SMS
VITE_SMS_API_ENDPOINT=https://api.zenvia.com/v2/channels/sms/messages
VITE_SMS_API_TOKEN=
VITE_PHONE_VERIFY_DEFAULT_CHANNEL=WHATSAPP
VITE_PHONE_VERIFY_GATEWAY_PROVIDER=z-api

# Supabase (Opcional para sincronização em nuvem caso ativado)
VITE_SUPABASE_URL=https://esaawnvmfkdfzpblkree.supabase.co/rest/v1/
