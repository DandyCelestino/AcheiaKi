rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isMaster() {
      return isSignedIn() && (
        request.auth.token.email == 'telecom.david@gmail.com' ||
        request.auth.uid == 'user-master-david'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Coleção de Usuários
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isOwner(userId) || isMaster());
      allow update: if isSignedIn() && (isOwner(userId) || isMaster());
      allow delete: if isMaster();
    }

    // Coleção de Lojas / Estabelecimentos
    match /merchants/{merchantId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isMaster() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow delete: if isMaster();
    }

    // Coleção de Produtos do Catálogo
    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isMaster() || isSignedIn();
      allow delete: if isMaster() || isSignedIn();
    }

    // Coleção de Pedidos e Transações
    match /orders/{orderId} {
      allow read: if isMaster() || (isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.merchantId == request.auth.uid));
      allow create: if isSignedIn();
      allow update: if isMaster() || (isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.merchantId == request.auth.uid));
      allow delete: if isMaster();
    }

    // Coleção de Notificações
    match /notifications/{notificationId} {
      allow read: if isMaster() || (isSignedIn() && (resource.data.recipientUserId == request.auth.uid || resource.data.recipientUserId == 'ALL'));
      allow create, update, delete: if isMaster();
    }

    // Trilha de Auditoria (Imutável)
    match /auditLogs/{logId} {
      allow read: if isMaster();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Coleção de Entregadores Parceiros
    match /deliveryDrivers/{driverId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isMaster() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isMaster();
    }

    // Coleção de Corridas e Despacho de Delivery
    match /deliveryRides/{rideId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isMaster() || isSignedIn();
      allow delete: if isMaster();
    }

    // Conexão de teste de saúde
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
